# TypeSafe AI Jev: https://console.typesafe.ai
JEV_API_KEY=
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# deepseek | compatible (Gemini OpenAI-compatible endpoint 등)
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 비용 상한: 분류 1회 + 후보 최대 6건의 독립 적합도 판정 1회
MATCH_CANDIDATE_LIMIT=6
API_TIMEOUT_MS=15000
